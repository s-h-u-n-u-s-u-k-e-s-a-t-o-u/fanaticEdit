@model fanaticEdit.DTO.AlbumTracks

@{
    ViewData["Title"] = "アルバム トラック編集";
}

<h1>@ViewData["Title"]</h1>
<h4>@Model.Album.Title</h4>
<hr />

<form asp-action="Edit" method="post">

    <input asp-for="@Model.Album.AlbumId" hidden />
    <input asp-for="@Model.Album.Code" hidden />
    <input asp-for="@Model.Album.Title" hidden />
    <input asp-for="@Model.Album.MediaType" hidden />
    <input asp-for="@Model.Album.ReleaseOn" hidden />
    <input asp-for="@Model.Album.LabelId" hidden />
    <input asp-for="@Model.Album.CreatedAt" hidden />
    <input asp-for="@Model.Album.ModifiedAt" hidden />
    <input asp-for="@Model.Album.AbstractAlbumID" hidden />

    <div class="mb-3">
        <button asp-controller="AlbumTracks" asp-action="AddLine" asp-route-id="@Model.Album.AlbumId" type="submit" class="btn btn-success">
            [+] トラックを追加
        </button>
    </div>

    @if (Model.Tracks != null && Model.Tracks.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-sm">
                <thead class="table-dark">
                    <tr>
                        <th>No.</th>
                        <th>タイトル</th>
                        <th>曲</th>
                        <th>長さ</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Tracks.Count; i++)
                    {
                        <tr>
                            <td style="width: 80px;">
                                <div>
                                    <input asp-for="@Model.Tracks[i].TrackId" hidden />
                                    <input asp-for="@Model.Tracks[i].AlbumId" hidden />
                                    <input asp-for="@Model.Tracks[i].CreatedAt" hidden />
                                    <input asp-for="@Model.Tracks[i].ModifiedAt" hidden />
                                </div>
                                <input asp-for="@Model.Tracks[i].TrackNo" class="form-control form-control-sm" type="number" />
                                <span asp-validation-for="@Model.Tracks[i].TrackNo" class="text-danger"></span>
                            </td>
                            <td>
                                <input asp-for="@Model.Tracks[i].Title" class="form-control form-control-sm" />
                                <span asp-validation-for="@Model.Tracks[i].Title" class="text-danger"></span>
                            </td>
                            <td style="width: 300px;">
                                <select asp-for="@Model.Tracks[i].SongId" 
                                        asp-items="@(ViewData["SongList"] as SelectList ?? new SelectList(new List<SelectListItem>()))"
                                        class="form-control form-control-sm">
                                    <option value="">-- 選択してください --</option>
                                </select>
                                <span asp-validation-for="@Model.Tracks[i].SongId" class="text-danger"></span>
                            </td>
                            <td style="width: 100px;">
                                <input asp-for="@Model.Tracks[i].Length" class="form-control form-control-sm" />
                                <span asp-validation-for="@Model.Tracks[i].Length" class="text-danger"></span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            トラックが登録されていません。上のボタンからトラックを追加してください。
        </div>
    }

    <div class="mt-3">
        <button type="submit" asp-action="Edit" class="btn btn-primary">保存</button>
        <a asp-controller="Albums" asp-action="Edit" asp-route-id="@Model.Album.AlbumId" class="btn btn-secondary">キャンセル</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
