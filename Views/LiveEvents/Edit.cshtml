@model fanaticEdit.Models.LiveEvent
@using fanaticEdit.Enum

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>LiveEvent</h4>
<hr />
<form asp-action="Edit">
    <div class="row">
        <div class="col-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="LiveEventId" class="control-label"></label>
                <input type="text" asp-for="LiveEventId" class="form-control" readonly />
            </div>
            <input type="hidden" asp-for="LiveEventId" />
            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Place" class="control-label"></label>
                <input asp-for="Place" class="form-control" />
                <span asp-validation-for="Place" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PerformAt" class="control-label"></label>
                <input asp-for="PerformAt" class="form-control" />
                <span asp-validation-for="PerformAt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CreatedAt" class="control-label"></label>
                <input asp-for="CreatedAt" class="form-control" readonly />
                <span asp-validation-for="CreatedAt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ModifiedAt" class="control-label"></label>
                <input asp-for="ModifiedAt" class="form-control" readonly />
                <span asp-validation-for="ModifiedAt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AbstractEventId" class="control-label"></label>
                <input asp-for="AbstractEventId" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="LiveEventNote.Note" class="control-label"></label>
                <TextArea asp-for="LiveEventNote.Note" class="form-control"></TextArea>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" method="post" asp-controller="LiveEvents" asp-action="Edit" asp-route-id="@Model.LiveEventId" />
            </div>
        </div>
        <div class="col-8">

            <div>
                <span>
                    <button asp-controller="LiveEvents" asp-action="AddNewSetList" asp-route-id="@Model.LiveEventId" type="submit">
                        [+]
                    </button>
                </span>
            </div>

            @if (Model.SetList != null)
            {
                <div class="row">
                    <div class="col-sm-1">削除</div>
                    <div class="col-sm-2">曲順</div>
                    <div class="col-sm-2">SONG ID</div>
                    <div class="col-sm-7">タイトル</div>
                </div>
                <div class="row">
                    <div class="col-sm-1"></div>
                    <div class="col-sm-2">歌唱</div>
                    <div class="col-sm-2">メドレー</div>
                    <div class="col-sm-2">カバー</div>
                    <div class="col-sm-5">パート</div>
                </div>
                <hr />
                @for (var i = 0; i < Model.SetList.Count; i++)
                {
                    <div class="row">
                        <div class="col-sm-1">
                            <input asp-for="SetList[i].SetListId" class="form-control" hidden />
                            <input asp-for="SetList[i].LiveEventId" class="form-control" hidden />
                            <input asp-for="SetList[i].CreatedAt" class="form-control" hidden />
                            <input asp-for="SetList[i].ModifiedAt" class="form-control" hidden />
                            <input asp-for="SetList[i].WillBeRemove" class="form-control form-check-input" />
                        </div>
                        <div class="col-sm-2"><input asp-for="SetList[i].SetListNo" class="form-control" type="number" /></div>
                        <div class="col-sm-2">
                            <div class="input-group">
                                <input asp-for="SetList[i].SongId" class="form-control songId-input"  />
                                <button type="button" class="btn btn-outline-secondary" onclick="openSongSelector(@i)">...</button>
                            </div>
                        </div>
                        <div class="col-sm-7">
                            <input asp-for="SetList[i].Title" class="form-control song-title-input"  />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-1"></div>
                        <div class="col-sm-2">
                            <input asp-for="SetList[i].Singing" class="form-control form-check-input" type="checkbox" />
                        </div>
                        <div class="col-sm-2">
                            <input asp-for="SetList[i].Medley" class="form-control form-check-input" type="checkbox" />
                        </div>
                        <div class="col-sm-2">
                            <input asp-for="SetList[i].Cover" class="form-control form-check-input" type="checkbox" />
                        </div>
                        <div class="col-sm-5">
                            <select asp-for="SetList[i].Part_Type" class="form-control">
                                <option value="">-- 選択 --</option>
                                <option value="@((int)Part.Main)" selected="@(Model.SetList[i].Part_Type == (int)Part.Main)">@Part.Main</option>
                                <option value="@((int)Part.Encore)" selected="@(Model.SetList[i].Part_Type == (int)Part.Encore)">@Part.Encore</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-1"></div>
                        <div class="col-sm-11"><input asp-for="SetList[i].Note.Note" class="form-control" placeholder="メモ" /></div>
                    </div>
                    <hr />
                }
                <div>
                    <span>
                        <button asp-controller="LiveEvents" asp-action="AddNewSetList" asp-route-id="@Model.LiveEventId" type="submit">
                            [+]
                        </button>
                    </span>
                </div>
            }
        </div>
    </div>
    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-primary" method="post" asp-controller="LiveEvents" asp-action="Edit" asp-route-id="@Model.LiveEventId" />
    </div>
</form>

<div>
    <a asp-action="Index">Back to List</a>
</div>

<script>
    let currentSongIndex = -1;

    function openSongSelector(index) {
        currentSongIndex = index;
        window.open('@Url.Action("SongSelector", "LiveEvents")', 'songSelector', 'width=600,height=400');
    }

    function setSongData(songId, title) {
        if (currentSongIndex >= 0) {
            const songIdInput = document.querySelectorAll('.songId-input')[currentSongIndex];
            const titleInput = document.querySelectorAll('.song-title-input')[currentSongIndex];
            songIdInput.value = songId;
            titleInput.value = title;
        }
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
