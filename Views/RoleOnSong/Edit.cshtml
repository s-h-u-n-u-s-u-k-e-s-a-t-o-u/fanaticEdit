@model fanaticEdit.DTO.EditRoleOnSong

@{
    ViewData["Title"] = "楽曲 ― 人物紐づけ";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="song.SongId" />
    <div class="row">

        <div class="col-md-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="@Model.song.SongId" />
            <spna>
                @Html.DisplayFor(model => model.song.Title)
                <input type="hidden" asp-for="@Model.song.Title" readonly="readonly" />
            </spna><br />
            <spna>
                @Html.DisplayFor(model => model.song.Kana)
                <input type="hidden" asp-for="@Model.song.Kana" readonly="readonly" />
            </spna><br />
            <spna>
                @Html.DisplayFor(model => model.song.CreatedAt)
                <input type="hidden" asp-for="@Model.song.CreatedAt" readonly="readonly" />
            </spna><br />
            <spna>
                @Html.DisplayFor(model => model.song.ModifiedAt)
                <input type="hidden" asp-for="@Model.song.ModifiedAt" readonly="readonly" />
            </spna><br />
            <div>
                <input type="submit" />
            </div>
        </div>
        <div class="col-md-8">
            @if (Model.personWithRoles != null)
            {
                <table>
                    @for (int i = 0; i < Model.personWithRoles.Count; i++)
                    {
                        <tr>
                            <td>
                                @Html.HiddenFor(m => m.personWithRoles[i].personWithRoleId)
                                <select asp-for="@Model.personWithRoles[i].role.RoleId" class="form-control" style="width:10em;">
                                    @foreach (var item in (SelectList?)ViewData["RoleList"])
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                    <option value="">選択してください</option>
                                </select>
                                <span asp-validation-for="@Model.personWithRoles[i].role.RoleId" class="text-danger"></span>
                            </td>
                            <td>
                                <input type="text" asp-for="@Model.personWithRoles[i].person.PersonId" class="form-control" style="width:20em;" />
                                <input type="hidden" asp-for="@Model.personWithRoles[i].person.Name" />
                            </td>
                            <td>
                                @Html.DisplayFor(m => m.personWithRoles[i].person.Name)
                            </td>
                        </tr>
                    }
                </table>

            }

        </div>
    </div>
</form>