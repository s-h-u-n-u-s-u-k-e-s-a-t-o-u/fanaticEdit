@model IEnumerable<fanaticEdit.Models.AbstractEvent>

@{
    ViewData["Title"] = "Abstract Event";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ModifiedAt)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <div>@Html.DisplayFor(modelItem => item.Title)</div>
                    <div>@Html.DisplayFor(modelItem => item.AbstractEventId)</div>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedAt)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ModifiedAt)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.AbstractEventId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.AbstractEventId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
